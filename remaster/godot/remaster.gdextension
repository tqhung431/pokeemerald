[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../target/debug/libgodot_bridge.so"
linux.release.x86_64 = "res://../target/release/libgodot_bridge.so"
windows.debug.x86_64 = "res://../target/debug/godot_bridge.dll"
windows.release.x86_64 = "res://../target/release/godot_bridge.dll"
macos.debug = "res://../target/debug/libgodot_bridge.dylib"
macos.release = "res://../target/release/libgodot_bridge.dylib"
macos.debug.arm64 = "res://../target/debug/libgodot_bridge.dylib"
macos.release.arm64 = "res://../target/release/libgodot_bridge.dylib"
